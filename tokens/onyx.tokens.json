      },
      "dark": {
        "surface": {
          "canvas": { "$value": "{onyx.color.neutral.jet}", "$type": "color" },
          "layer-01": { "$value": "{onyx.color.neutral.onyx}", "$type": "color" },
          "layer-02": { "$value": "{onyx.color.neutral.graphite}", "$type": "color" },
          "field": { "$value": "{onyx.color.neutral.graphite}", "$type": "color" },
          "hover": { "$value": "{onyx.color.neutral.charcoal}", "$type": "color" },
          "selected": { "$value": "{onyx.color.neutral.charcoal}", "$type": "color" }
        },
        "text": {
          "primary": { "$value": "{onyx.color.neutral.mist}", "$type": "color" },
          "secondary": { "$value": "{onyx.color.neutral.ash-50}", "$type": "color" }
