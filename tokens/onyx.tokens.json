      "10": { "$value": "5rem", "$type": "dimension" },
      "11": { "$value": "6rem", "$type": "dimension" },
      "12": { "$value": "10rem", "$type": "dimension" },
      "13": { "$value": "12rem", "$type": "dimension" }
