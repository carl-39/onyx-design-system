    "space": {
      "01": { "$value": "0.25rem", "$type": "dimension" },
      "02": { "$value": "0.5rem", "$type": "dimension" },
      "03": { "$value": "0.75rem", "$type": "dimension" },
      "04": { "$value": "1rem", "$type": "dimension" },
      "05": { "$value": "1.5rem", "$type": "dimension" },
      "06": { "$value": "2rem", "$type": "dimension" },
