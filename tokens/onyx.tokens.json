        "red-soft": { "$value": "#F8DDDA", "$type": "color" },
        "blue": { "$value": "#246BCE", "$type": "color" },
        "blue-bright": { "$value": "#6AA8FF", "$type": "color" },
        "blue-soft": { "$value": "#DCE9FA", "$type": "color" }
      }
