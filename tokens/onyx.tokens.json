        "action": { "primary": { "$value": "{onyx.color.signal.orange}", "$type": "color" } },
        "focus": { "ring": { "$value": "{onyx.color.neutral.mist}", "$type": "color" } }
      }
    },
    "component": {
      "button": {
        "primary": {
          "background": { "$value": "{onyx.color.signal.orange}", "$type": "color" },
          "background-hover": { "$value": "{onyx.color.signal.orange-hover}", "$type": "color" },
          "background-active": { "$value": "{onyx.color.signal.orange-strong}", "$type": "color" },
          "text": { "$value": "{onyx.color.neutral.jet}", "$type": "color" }
        }
      },
      "field": {
        "border": { "$value": "{onyx.color.neutral.ash-30}", "$type": "color" },
        "border-focus": { "$value": "{onyx.color.signal.orange-strong}", "$type": "color" }
      },
      "table": {
        "header": { "background": { "$value": "{onyx.color.neutral.mist}", "$type": "color" } },
        "row-selected-indicator": { "$value": "{onyx.color.signal.orange}", "$type": "color" }
      },
      "notification": {
        "error": { "border": { "$value": "{onyx.color.signal.red}", "$type": "color" } },
        "warning": { "border": { "$value": "{onyx.color.signal.amber-strong}", "$type": "color" } }
      }
    }
  }
